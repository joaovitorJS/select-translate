{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Select Translate",
  "version": "0.2.1",
  "identifier": "com.joaov.select-translate",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Select Translate",
        "width": 800,
        "height": 600
      },
      {
        "label": "popover",
        "url": "popover.html",
        "title": "Select Translate — Popover",
        "width": 360,
        "height": 160,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Portuguese", "English"]
      }
    }
  }
}
